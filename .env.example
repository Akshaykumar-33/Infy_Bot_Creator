# Cursor / Grok model credential (required for model turns, evals, playground chat)
# CURSOR_API_KEY=
# Or: CURSOR_API_KEY_FILE=
# Or: CURSOR_SERVICE_ACCOUNT_KEY=

# Microsoft Graph (optional). When unset, tools use structured mock data.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# Optional mailbox / user to act as for app-only Graph calls:
# MICROSOFT_USER_ID=me
